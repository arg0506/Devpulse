# Copy to .env and fill in what you need. Everything is optional for local development.

# Port the combined API + web server listens on.
PORT=3000

# Signs session tokens. Required in production: use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Google Gemini powers @gemini replies, the console `ai` command and Agent Studio nodes.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash"

# Optional PostgreSQL mirror via Prisma. Without it, data lives in backend-data.json.
# DATABASE_URL="postgresql://username:password@localhost:5432/lemo?schema=public"

# Optional. Without a key, checkout runs in demo mode and upgrades instantly.
# STRIPE_SECRET_KEY="sk_test_..."
